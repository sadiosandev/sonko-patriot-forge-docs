{
  "name": "sonkopatriot-forge-docs",
  "version": "1.0.4",
  "private": true,
  "description": "Official React documentation website for SonkoPatriot Forge",
  "scripts": {
    "docs:generate": "node scripts/generate-doc-pages.cjs",
    "prestart": "npm run docs:generate",
    "start": "webpack serve --mode development --open",
    "prebuild": "npm run docs:generate",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/create-github-pages-fallback.cjs",
    "build:github-pages": "webpack --mode production"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "fuse.js": "^7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
